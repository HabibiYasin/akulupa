  "fixed_sql": [
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "item_locations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_locations\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"item_id\" INTEGER NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"location\" TEXT NOT NULL, \"photo_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"scheduled_at\" INTEGER NOT NULL, \"snoozed_until\" INTEGER NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"is_important\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_important\" IN (0, 1)), \"calendar_event_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"schedule_time\" INTEGER NOT NULL CHECK (schedule_time BETWEEN 0 AND 1439), \"repeat_pattern\" TEXT NOT NULL DEFAULT 'daily', \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"weekday\" INTEGER NULL, \"target_count\" INTEGER NOT NULL DEFAULT 1, \"unit\" TEXT NULL, \"end_time\" INTEGER NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "habit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"habit_id\" INTEGER NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"completed_at\" INTEGER NULL, \"progress\" INTEGER NOT NULL DEFAULT 0, UNIQUE (\"habit_id\", \"date\"));"
        }
      ]
    },
    {
      "name": "activity_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"event_time\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"personality\" TEXT NOT NULL DEFAULT 'relaxed', PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    }
  ]
